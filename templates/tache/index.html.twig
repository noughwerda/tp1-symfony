{% extends 'base.html.twig' %}

{% block title %}Liste des tâches{% endblock %}

{% block body %}
    <h1 class="mb-4">Mes tâches</h1>

    <a href="{{ path('app_tache_ajouter') }}" class="btn btn-primary mb-3">Ajouter une tâche</a>

    {% if taches is empty %}
        <div class="alert alert-info">Aucune tâche pour le moment.</div>
    {% else %}
        <table class="table table-bordered table-hover">
            <thead class="table-dark text-center">
                <tr>
                    <th>ID</th>
                    <th>Titre</th>
                    <th>Statut</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                {% for tache in taches %}
                    <tr>
                        <td class="text-center">{{ tache.id }}</td>
                        <td>{{ tache.titre }}</td>
                        <td class="text-center">
                            {% if tache.terminee %}
                                <span class="badge bg-success">Terminée</span>
                            {% else %}
                                <span class="badge bg-warning text-dark">À faire</span>
                            {% endif %}
                        </td>
                        <td class="text-center">
                            <a href="{{ path('app_tache_detail', {id: tache.id}) }}" class="btn btn-sm btn-outline-secondary">Voir</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        <p class="text-muted">{{ taches|length }} tâche(s)</p>
    {% endif %}
{% endblock %}